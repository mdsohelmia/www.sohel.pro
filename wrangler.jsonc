{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site: every page is prerendered by `vite build` into dist/client,
  // so the Worker only serves assets. No server code runs.
  "name": "sohel-pro",
  "compatibility_date": "2026-10-07",
  // Keep the *.workers.dev URL as a preview; pages declare sohel.pro as
  // canonical, so it doesn't compete in search.
  "workers_dev": true,
  // sohel.pro is canonical; www serves the same site and pages declare
  // https://sohel.pro as canonical.
  "routes": [
    { "pattern": "sohel.pro", "custom_domain": true },
    { "pattern": "www.sohel.pro", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    // Canonical URLs have no trailing slash: /about serves about/index.html
    // and /about/ redirects to /about.
    "html_handling": "drop-trailing-slash",
    // Unknown URLs get dist/client/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
